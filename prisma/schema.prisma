generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Painting {
  id               String      @id @default(cuid())
  title_en         String
  title_ru         String
  title_uz         String
  description_en   String?
  description_ru   String?
  description_uz   String?
  size             String
  technique_en     String
  technique_ru     String?
  technique_uz     String?
  year             Int
  price            Float       // Original base price in USD
  discount_price   Float?      // Computed or manual discount price
  discount_starts_at DateTime?
  discount_ends_at   DateTime?
  is_sold          Boolean     @default(false)
  sold_at          DateTime?
  is_featured      Boolean     @default(false)
  images           String      // JSON array of image URLs/paths
  views_count      Int         @default(0)

  artist_id        String
  artist           Artist      @relation(fields: [artist_id], references: [id], onDelete: Cascade)

  category_id      String
  category         Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)

  inquiries        Inquiry[]
  reviews          Review[]
  wishlist_items   WishlistItem[]
  views            PaintingView[]

  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
}

model Artist {
  id           String     @id @default(cuid())
  name         String
  photo        String?
  initials     String?
  bio_en       String
  bio_ru       String
  bio_uz       String
  specialty_en String
  specialty_ru String
  specialty_uz String

  // The artist's product type (a top-level Category, e.g. "Somon ishlari")
  // — lets the Paintings form auto-pick ota-kategoriya once the artist is
  // chosen, so the admin only has to pick the bola-kategoriya (subject).
  category_id  String?
  category     Category?  @relation(fields: [category_id], references: [id], onDelete: SetNull)

  paintings    Painting[]
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
}

model Category {
  id         String     @id @default(cuid())
  slug       String     @unique
  name_en    String
  name_ru    String
  name_uz    String

  // Groups subject-matter categories (Nature, Portraits, ...) under a
  // physical product type (Kartina, Kulolchilik, ...). Top-level categories
  // (the product types themselves) have parent_id = null. Only one level
  // deep is used today, but nothing here prevents going deeper later.
  parent_id  String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")

  paintings  Painting[]
  artists    Artist[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
}

// Optional add-ons (protective case, etc.) a curator can offer alongside an
// inquiry — surfaced as checkboxes on the inquiry/service-request form.
// product_types values are either a Category.slug (for painting inquiries —
// scoped to that painting's actual gallery category) or one of the fixed
// Services codes: "MURAL", "CERAMICS", "CUSTOM". Empty array = applies
// everywhere.
model Accessory {
  id            String   @id @default(cuid())
  name_en       String
  name_ru       String
  name_uz       String
  // Size-tiered pricing (a protective case for a small piece shouldn't cost
  // the same as one for a large canvas). price_medium/price_large fall back
  // to price_small when unset, so a single price still works for accessories
  // that don't vary by size (e.g. a flat consultation fee).
  price_small   Float
  price_medium  Float?
  price_large   Float?
  is_active     Boolean  @default(true)
  product_types String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Discount {
  id         String    @id @default(cuid())
  scope      String    // SITE, CATEGORY, ARTIST, PAINTING
  target_id  String?   // category_id, artist_id, or painting_id (null for SITE)
  percent    Float     // e.g. 15.0
  starts_at  DateTime?
  ends_at    DateTime?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  password_hash  String?
  country        String?
  role           String           @default("USER") // USER, ADMIN
  email_verified Boolean          @default(false)
  auth_provider  String           @default("EMAIL") // EMAIL, GOOGLE, APPLE
  must_change_password Boolean     @default(false)

  inquiries        Inquiry[]
  service_requests ServiceRequest[]
  reviews          Review[]
  wishlist_items   WishlistItem[]

  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
}

model Inquiry {
  id           String    @id @default(cuid())
  user_id      String?
  user         User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  guest_name   String?
  guest_email  String?
  guest_phone  String?

  painting_id  String
  painting     Painting  @relation(fields: [painting_id], references: [id], onDelete: Cascade)

  message      String?
  status       String    @default("NEW") // NEW, IN_PROGRESS, ANSWERED, COMPLETED
  admin_reply  String?

  // Snapshot (JSON array of {id,name_en,name_ru,name_uz,price}) of whichever
  // optional accessories the customer checked at submission time — kept as a
  // snapshot so later catalog edits never rewrite past inquiries.
  selected_accessories String?
  // Curator-entered final price once a deal is actually agreed (may differ
  // from the painting's list price + accessories, e.g. after a negotiated
  // discount) — purely for internal record-keeping, never a checkout charge.
  final_price          Float?

  // When the inquiry became COMPLETED (the sale): the review request goes
  // out then, and one reminder 3 weeks later if no review has come in
  // (daily cron: src/app/api/cron/review-reminders).
  completed_at            DateTime?
  review_reminder_sent_at DateTime?

  messages     InquiryMessage[]

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

model ServiceRequest {
  id            String    @id @default(cuid())
  user_id       String?
  user          User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  guest_name    String
  guest_contact String    // Email or Telegram
  service_type  String    // MURAL, CERAMICS, CUSTOM
  description   String?
  status        String    @default("NEW") // NEW, IN_PROGRESS, COMPLETED
  admin_notes   String?

  // Same accessory-snapshot / internal final-price pattern as Inquiry.
  selected_accessories String?
  final_price          Float?

  messages      ServiceRequestMessage[]

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Review {
  id          String    @id @default(cuid())
  user_id     String?
  user        User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  author_name String
  painting_id String?
  painting    Painting? @relation(fields: [painting_id], references: [id], onDelete: SetNull)

  rating      Int       @default(5)
  text        String
  is_approved Boolean   @default(false)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([painting_id])
  @@index([user_id])
  @@index([is_approved])
}

model WishlistItem {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  painting_id String
  painting    Painting @relation(fields: [painting_id], references: [id], onDelete: Cascade)

  created_at  DateTime @default(now())

  @@unique([user_id, painting_id])
}

model OtpVerification {
  id         String   @id @default(cuid())
  email      String
  code       String
  purpose    String   @default("SIGNUP") // SIGNUP or PASSWORD_RESET
  expires_at DateTime
  created_at DateTime @default(now())
}

model SiteSettings {
  id            String   @id @default("default")
  gallery_name  String   @default("Art Qala")
  phone         String   @default("+998 66 233 44 55")
  email         String   @default("info@artqala.uz")
  address       String   @default("Barakhon Madrasah, Tashkent, Uzbekistan")
  location_map  String   @default("https://maps.app.goo.gl/FvSvu2kJ3Mqdwhzg8")
  // JSON array of {address, url} — lets the admin list any number of
  // physical addresses, each with its own map link, instead of the single
  // address/location_map pair above (kept only as a fallback for sites that
  // predate this field, and as the primary address in the JSON-LD schema).
  locations     String?
  working_hours String   @default("Mon - Sun: 09:00 - 19:00")
  telegram      String   @default("https://t.me/artqala")
  instagram     String   @default("https://instagram.com/artqala")
  // JSON array of {label, url} — lets the admin add any number of social/
  // messenger links (Telegram, Instagram, WhatsApp, Facebook, ...) instead
  // of being limited to the two fixed fields above. Those two fields are
  // kept only as a fallback seed/for older code paths; new UI reads/writes
  // this field exclusively.
  social_links  String?
  about_en      String   @default("Art Qala is a premier art gallery and studio located in the historic heart of Tashkent, Uzbekistan, celebrating Central Asian heritage.")
  about_ru      String   @default("Art Qala — ведущая художественная галерея и студия в историческом центре Ташкента.")
  about_uz      String   @default("Art Qala — Toshkent shahrining tarixiy markazida joylashgan yetakchi san'at galereyasi va studiyasi.")

  rate_usd      Float    @default(12850)
  rate_eur      Float    @default(13900)
  rate_rub      Float    @default(140)
  manual_rates  Boolean  @default(false)

  updated_at    DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  subject    String?
  message    String
  is_read    Boolean  @default(false)
  status     String   @default("NEW") // NEW, ANSWERED, COMPLETED
  admin_reply String?
  created_at DateTime @default(now())
}

model PaintingView {
  id          String   @id @default(cuid())
  painting_id String
  painting    Painting @relation(fields: [painting_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@index([painting_id])
  @@index([created_at])
}

model SiteVisit {
  id         String   @id @default(cuid())
  path       String   @default("/")
  created_at DateTime @default(now())

  @@index([created_at])
}

model InquiryMessage {
  id         String   @id @default(cuid())
  inquiry_id String
  inquiry    Inquiry  @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)
  sender     String   // "CUSTOMER" or "ADMIN"
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([inquiry_id])
  @@index([created_at])
}

model ServiceRequestMessage {
  id                 String         @id @default(cuid())
  service_request_id String
  service_request    ServiceRequest @relation(fields: [service_request_id], references: [id], onDelete: Cascade)
  sender             String         // "CUSTOMER" or "ADMIN"
  message            String
  is_read            Boolean        @default(false)
  created_at         DateTime       @default(now())

  @@index([service_request_id])
  @@index([created_at])
}


